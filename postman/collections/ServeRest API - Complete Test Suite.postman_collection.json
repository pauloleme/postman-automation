  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Setup - Create Admin User for Auth",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email for test user",
                  "const timestamp = Date.now();",
                  "const testEmail = 'admin_' + timestamp + '@teste.com';",
                  "pm.globals.set('testEmail', testEmail);",
                  "pm.globals.set('testPassword', 'teste123');"
                ],
                "type": "text/javascript",
                "id": "c3a145de-6c9a-4278-9a47-4b0768978271"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 - User created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains success message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Cadastro realizado com sucesso');",
                  "});",
                  "",
                  "pm.test('Response contains user ID', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData._id).to.be.a('string');",
                  "    pm.globals.set('adminUserId', jsonData._id);",
                  "});",
                  "",
                  "// Rate limit check",
                  "pm.test('Rate limit headers present', function () {",
                  "    // ServeRest may not have rate limit headers, but we check response time",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript",
                "id": "77722edc-6351-4b9d-a7e1-1f3bceaccbda"
              }
            }
          ],
          "id": "62815d2d-93df-494c-b4b3-e43ed35da53c",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"nome\": \"Admin Test User\",\n    \"email\": \"admin_{{$timestamp}}@teste.com\",\n    \"password\": \"teste123\",\n    \"administrador\": \"true\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "response": []
        }
      ],
