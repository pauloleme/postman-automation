  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Create Admin User for Auth",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique email for test user",
                  "const timestamp = Date.now();",
                  "const testEmail = `admin_${timestamp}@teste.com`;",
                  "pm.collectionVariables.set('testEmail', testEmail);",
                  "pm.collectionVariables.set('testPassword', 'teste123');"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 - User created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response contains success message', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql('Cadastro realizado com sucesso');",
                  "});",
                  "",
                  "pm.test('Response contains user ID', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData._id).to.be.a('string');",
                  "    pm.collectionVariables.set('adminUserId', jsonData._id);",
                  "});",
                  "",
                  "// Rate limit check",
                  "pm.test('Rate limit headers present', function () {",
                  "    // ServeRest may not have rate limit headers, but we check response time",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
